# =====================================================================
#  .gitignore — SmartCityNet VANET
#  Criterio: al repositorio SOLO sube el PROGRAMA (código fuente).
#  Todo lo que sea generado, pesado, personal o documentación de trabajo
#  se queda en local.
# =====================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ---- Entornos virtuales (¡NUNCA commitear!) ----
.venv/
venv/
env/
ENV/

# ---- Dependencias y build del frontend ----
# (web/.gitignore ya las cubre; se repiten aquí por si se mueve la carpeta)
node_modules/
web/node_modules/
web/dist/

# ---- DATOS GENERADOS por una corrida ------------------------------
# output/ lo produce el propio programa (OSM + SUMO + tuplas). Pesaba
# 137 MB, con dos archivos de ~50 MB cada uno: era el 96 % del repo.
# Se regenera entero desde la interfaz con "Generar escenario".
output/

# El .dat del solver también es generado en cada optimización.
optimizacion/rsu_backend.dat
# (rsu_micro.dat SÍ se versiona: es el ejemplo mínimo de validación)

# ---- Documentación de trabajo (no es el programa) ----
explicaciones/
Jornadas SmartCityNet/

# ---- Datos personales ----
# El CV lleva teléfono, dirección y los datos de contacto de terceros.
CV/

# ---- Herramientas locales del editor / asistente ----
.claude/skills/
skills-lock.json

# ---- LaTeX (basura de compilación) ----
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.run.xml
*.bcf
*.nav
*.snm
*.vrb

# ---- Artefactos sueltos de SUMO (randomTrips deja esto en la raíz) ----
trips.trips.xml

# ---- Sistema operativo ----
.DS_Store
Thumbs.db
desktop.ini
